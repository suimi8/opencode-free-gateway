# ══════════════════════════════════════════════════════════════════════
# OpenCode 免费层网关 · 管理面板 —— 环境变量模板
#
# 用法（面板本身不读 .env 文件，需要由外层注入）：
#   A) 手动启动时在 shell 里 source（注意 export，否则子进程看不到）:
#        set -a; . ./09-服务端部署/.env.example; set +a
#        bash 09-服务端部署/start.sh --daemon
#   B) systemd: 复制到 /etc/opencode-gateway.env 并在 unit 里用
#        EnvironmentFile=-/etc/opencode-gateway.env
#   C) docker compose: 用 env_file: 或 environment: 直接写（见 docker-compose.yml）
#
# 本文件只是模板：把 .env.example 复制成 .env 再改，不要直接改模板。
# 等号两侧不要留空格，值不要加引号（除非值本身含空格）。
# ══════════════════════════════════════════════════════════════════════

# ── 监听地址 PANEL_HOST ─────────────────────────────────────────────
# 面板自身默认值是 127.0.0.1（只允许本机访问）。
#   * 本机 + nginx 反代（生产推荐，最安全）: 127.0.0.1
#   * 直接对局域网/容器暴露:                  0.0.0.0
#   * 只允许 IPv6:                            ::
# 本项目的 start.sh 默认按 0.0.0.0 启动；systemd 单元也写死 0.0.0.0。
# ⚠️ 0.0.0.0 意味着管理面板在网络可达 —— 面板登录 cookie 没有 Secure 标志、
#    登录接口也没有限速，**绝不要让它直接暴露公网**，前面必须挂 HTTPS 反代。
PANEL_HOST=0.0.0.0

# ── 监听端口 PANEL_PORT ─────────────────────────────────────────────
# 面板自身默认值 8790。改动后 nginx 的 proxy_pass 与 systemd 的
# ExecStart 无需改（端口来自环境变量），但 nginx.conf.example 里
# proxy_pass 的端口要同步改。
PANEL_PORT=8790

# ── 数据库位置 PANEL_DB ─────────────────────────────────────────────
# 面板原生支持（见 01-管理面板/db.mjs）。留空/不设 = 与 server.mjs 同目录的 panel.db。
# 部署到容器或想把数据放数据盘时设成绝对路径，例如：
#   PANEL_DB=/var/lib/ocgw/panel.db
#   PANEL_DB=/app/data/panel.db          (Docker)
# ⚠️ panel.db 是 WAL 模式，panel.db-wal / panel.db-shm 是数据库的一部分：
#    * 必须放在【同一个目录】，挂卷要挂目录而不是单个文件
#    * 备份只能用 09-服务端部署/snapshot-db.mjs（VACUUM INTO），不能只 cp panel.db
# PANEL_DB=

# ── Node 可执行文件 NODE_EXE ────────────────────────────────────────
# 仅被 start.sh / status.sh 读取（面板自己不读）。留空则自动按顺序查找：
#   $NODE_EXE -> PATH 上的 node -> $HOME/node22/bin/node
# 注意：管理面板依赖内置模块 node:sqlite，需要 **Node >= 22.5**。
# 使用 install-node.sh 免 root 便携安装时，典型值是:
#   NODE_EXE=$HOME/node22/bin/node
# 但写成 $HOME 展开需要 shell 参与；在 .env 里请写绝对路径，例如:
#   NODE_EXE=/home/ocgw/node22/bin/node
NODE_EXE=

# ── 以下为本项目脚本使用、面板本身不读取的可选项 ─────────────────────

# start.sh 后台启动后，等待端口就绪的最长秒数（默认 30）
OCGW_READY_TIMEOUT=30

# stop.sh 先发 SIGTERM 的宽限秒数，超时后 SIGKILL（默认 10）
OCGW_STOP_GRACE=10

# 自检脚本 SELFTEST 相关（selftest.sh 使用，见其文件头注释）
# OCGW_CLEAR_PROXY=1   在副本里清空渠道代理，验证直连能否过门禁
# OCGW_KEEP=1          保留自检临时目录
OCGW_CLEAR_PROXY=0
OCGW_KEEP=0
